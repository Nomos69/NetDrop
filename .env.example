# Copy to .env to customize. Existing environment variables take precedence.
NETDROP_HOST=0.0.0.0
NETDROP_PORT=8000
# Lifetime for files, text, and links.
NETDROP_FILE_TTL_SECONDS=1800
# Enforced upload limit in MiB (1024 * 1024 bytes).
NETDROP_MAX_UPLOAD_MB=100
# Interval between cleanup scans; expired downloads are blocked immediately.
NETDROP_CLEANUP_INTERVAL_SECONDS=5
# This server's mode: local or online. Online requires HTTPS.
NETDROP_SHARING_MODE=local
# Host LAN origin used in local invitation links (example: http://192.168.1.12:8000).
NETDROP_LOCAL_URL=
# Public HTTPS origin; required on the online server, optional on the local server.
NETDROP_ONLINE_URL=

# Close rooms with no live connections/transfers after this many idle seconds.
NETDROP_ROOM_IDLE_SECONDS=1800
