# Copy to .env to customize. Existing environment variables take precedence.
NETDROP_HOST=0.0.0.0
NETDROP_PORT=8000
# Lifetime for uploaded files. Text and links remain until their room closes.
NETDROP_FILE_TTL_SECONDS=1800
# Exact maximum bytes per uploaded file (50 decimal MB by default).
NETDROP_MAX_UPLOAD_BYTES=50000000
# Interval between cleanup scans; expired downloads are blocked immediately.
NETDROP_CLEANUP_INTERVAL_SECONDS=5
# This server's mode: local or online. Online requires HTTPS.
NETDROP_SHARING_MODE=local
# Host LAN origin used in local invitation links (example: http://192.168.1.12:8000).
NETDROP_LOCAL_URL=
# Public HTTPS origin; required on the online server, optional on the local server.
NETDROP_ONLINE_URL=

# Rooms expire three days after creation, regardless of activity.
NETDROP_ROOM_TTL_SECONDS=259200
# Expiring email invitation token lifetime.
NETDROP_INVITATION_TTL_SECONDS=86400

# Optional email invitations through Brevo's HTTPS REST API (not SMTP).
# Use an API key from Brevo > SMTP & API > API Keys and a verified sender.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=NetDrop
